# .env.example — mall för sie-mcp:s lokala konfiguration.
#
# INGA VERKLIGA VÄRDEN här. Denna fil ligger kvar i repo/Drive som dokumentation.
# Den RIKTIGA .env med hemligheter skapas av appen i en säker, icke-synkad
# katalog (Paket B1): %LOCALAPPDATA%\sie-mcp\secrets\.env på Windows, eller
# den katalog du pekar ut med miljövariabeln SIE_MCP_DATA_ROOT.
#
# Kopiera ALDRIG denna fil rakt in i en Google Drive-synkad projektmapp med
# ifyllda värden — hela poängen med Paket B1 är att hemligheter inte samsynkas.

# --- App-konfiguration (skrivs av appens sidomeny till secrets\.env) ---------
SIE_MCP_AI_LEVERANTOR=
SIE_MCP_AI_API_NYCKEL=
SIE_MCP_AI_VALD_MODELL=
SIE_MCP_SPIRIS_CLIENT_ID=
SIE_MCP_SPIRIS_CLIENT_SECRET=

# Symmetrisk nyckel för de krypterade lokala liggarna (mask_dict/allowlist/
# konteringsminne). Genereras automatiskt om den saknas. Fyll INTE i för hand.
SIE_MCP_FERNET_KEY=

# --- Valfri, explicit datarot -----------------------------------------------
# Sätt om du vill lägga secrets/state/logs på en annan icke-synkad plats än
# %LOCALAPPDATA%\sie-mcp. Måste vara en absolut, icke-synkad sökväg (valideras).
# SIE_MCP_DATA_ROOT=

# --- MCP-serverns Spiris-credentials (PROCESSMILJÖ, inte denna fil) ----------
# MCP-servern läser SPIRIS_CLIENT_ID/SPIRIS_CLIENT_SECRET ur PROCESSENS
# miljövariabler (os.environ), inte ur .env. Sätt dem i den terminal/tjänst som
# startar servern — t.ex. i PowerShell för den aktuella sessionen:
#     $env:SPIRIS_CLIENT_ID = "<ditt-client-id>"
#     $env:SPIRIS_CLIENT_SECRET = "<din-client-secret>"
# Lagra dem ALDRIG i en Drive-synkad fil. B1 importerar dem aldrig automatiskt
# från .env.
